# WeatherPulse Enterprise configuration placeholders.
# Copy this file to .env for local development and replace placeholder values.
# Never commit real credentials.

WEATHERPULSE_ENV=local
WEATHERPULSE_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/weatherpulse.db

# Backward-compatible local override supported by the app.
# WEATHERPULSE_DATABASE_URL=sqlite:///./data/weatherpulse.db

# OpenWeatherMap ingestion client (Step 4).
OPENWEATHER_API_KEY=replace-with-your-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_TIMEOUT_SECONDS=10
OPENWEATHER_MAX_RETRIES=3
OPENWEATHER_RETRY_BACKOFF=2

# Backward-compatible aliases supported by the configuration loader.
# OPENWEATHERMAP_API_KEY=replace-with-your-api-key
# OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# ETL pipeline city queries (OpenWeatherMap q parameter values).
WEATHERPULSE_ETL_CITIES=London,GB,Kolkata,IN,Delhi,IN

# Future scheduler placeholder. Not used by the foundation yet.
WEATHERPULSE_SCHEDULE_CRON=0 * * * *
